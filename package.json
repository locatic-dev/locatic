{
  "name": "locatic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:development": "CLOUDFLARE_ENV=development vite build --mode development",
    "build:production": "CLOUDFLARE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --project=setup",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "lint": "pnpm exec oxlint",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "pnpm exec oxfmt . --ignore-path .oxfmtignore && pnpm exec oxlint --fix",
    "check": "pnpm exec oxfmt --check . --ignore-path .oxfmtignore && pnpm exec oxlint",
    "ci:quality": "pnpm run check && pnpm run typecheck && pnpm run test",
    "ci:build": "pnpm run build",
    "cities:generate": "node scripts/geonames-to-cities-seed.mjs",
    "reactions:generate": "node scripts/reactions-to-seed.mjs",
    "readmes:backfill:development": "pnpm exec convex run --push github_actions:backfillProjectReadmes",
    "readmes:backfill:production": "pnpm exec convex run --prod github_actions:backfillProjectReadmes",
    "deploy:convex": "pnpm exec convex deploy",
    "deploy:convex:development": "pnpm exec convex deploy",
    "deploy:convex:production": "pnpm exec convex deploy",
    "deploy:worker:development": "pnpm run build:development && pnpm exec wrangler deploy --env development",
    "deploy:worker:production": "pnpm run build:production && pnpm exec wrangler deploy --env production",
    "deploy": "pnpm run deploy:worker:production"
  },
  "dependencies": {
    "@clerk/backend": "3.4.4",
    "@clerk/tanstack-react-start": "^1.2.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "0.1.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-router": "1.170.1",
    "@tanstack/react-router-ssr-query": "1.167.0",
    "@tanstack/react-start": "1.168.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.39.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "svix": "^1.93.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.35",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  }
}
