{
  "name": "locatic",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && pnpm run notices:complete",
    "build:development": "CLOUDFLARE_ENV=development vite build --mode development && pnpm run notices:complete",
    "build:production": "CLOUDFLARE_ENV=production vite build --mode production && pnpm run notices:complete",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:components": "playwright test --config playwright.components.config.ts",
    "e2e:public:production": "pnpm run build && E2E_PRODUCTION_SERVER=1 pnpm exec playwright test --project=chromium-public",
    "e2e:auth": "playwright test --project=setup",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "lint": "pnpm exec oxlint",
    "lint:a11y": "pnpm exec oxlint --disable-typescript-plugin --disable-unicorn-plugin --disable-oxc-plugin src",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "pnpm exec oxfmt . --ignore-path .oxfmtignore && pnpm exec oxlint --fix",
    "contrast:check": "node scripts/check-contrast.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "seo:check": "node scripts/check-seo-live.mjs",
    "check:arbitrary": "node scripts/check-arbitrary-values.mjs",
    "check:collect": "node scripts/check-collect-calls.mjs",
    "design:tokens": "node scripts/generate-design-tokens.mjs",
    "design:tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "check": "pnpm exec oxfmt --check . --ignore-path .oxfmtignore && pnpm exec oxlint && pnpm run contrast:check && pnpm run check:arbitrary && pnpm run check:collect && pnpm run design:tokens:check",
    "ci:quality": "pnpm run check && pnpm run typecheck && pnpm run test",
    "ci:build": "pnpm run build && pnpm run bundle:check",
    "cities:generate": "node scripts/geonames-to-cities-seed.mjs",
    "cities:catalog": "node scripts/verify-city-catalog.mjs",
    "oss:audit": "node scripts/oss-readiness-audit.mjs",
    "reactions:generate": "node scripts/reactions-to-seed.mjs",
    "geo:land-dots": "node scripts/generate-land-dots.mjs",
    "brand:images": "node scripts/generate-brand-images.mjs",
    "readmes:backfill:development": "pnpm exec convex run --push github_actions:backfillProjectReadmes",
    "readmes:backfill:production": "pnpm exec convex run --prod github_actions:backfillProjectReadmes",
    "project-reactions:backfill:development": "pnpm exec convex run --push projects:backfillProjectReactionCounts",
    "project-reactions:backfill:production": "pnpm exec convex run --prod projects:backfillProjectReactionCounts",
    "deploy:convex": "pnpm exec convex deploy",
    "deploy:convex:development": "pnpm exec convex deploy",
    "deploy:convex:production": "pnpm exec convex deploy",
    "deploy:worker:development": "pnpm run build:development && pnpm exec wrangler deploy --env development",
    "deploy:worker:production": "pnpm run build:production && pnpm exec wrangler deploy --env production",
    "deploy": "pnpm run deploy:worker:production",
    "notices:complete": "node scripts/complete-bundle-notices.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.26.0",
    "@clerk/tanstack-react-start": "^1.7.4",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "0.1.0",
    "@convex-dev/resend": "0.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/render": "2.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "lucide-react": "^0.577.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "svix": "^1.93.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/testing": "^2.0.35",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "0.0.54",
    "d3-geo": "^3.1.1",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.155.0"
  }
}
