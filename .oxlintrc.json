{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "jsx-a11y"],
  "options": {
    "typeAware": true
  },
  "settings": {
    // Map the UI primitives to the native elements they render so label,
    // role and interaction rules see through them.
    "jsx-a11y": {
      "components": {
        "Input": "input",
        "Textarea": "textarea",
        "Button": "button"
      }
    }
  },
  "rules": {
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  // jsx-a11y allowlist: hits that existed when the rules landed. They stay
  // visible as warnings (report-only); any new hit is an error and fails
  // `pnpm check`. Remove an entry once its file is fixed.
  "overrides": [
    {
      // Client code may import runtime helpers from convex/lib only when the
      // module is pure: no database, ctx, _generated/server or scheduler
      // imports, so it bundles into the browser without server code. The
      // allowed modules are listed here and guarded by the next override;
      // type-only imports of any convex/lib module stay allowed.
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/convex/lib/*",
                  "!**/convex/lib/explore",
                  "!**/convex/lib/geo",
                  "!**/convex/lib/topics"
                ],
                "allowTypeImports": true,
                "message": "Client code may only import pure convex/lib modules (explore, geo, topics). Import types with `import type`, or move the helper to a pure module and allowlist it in .oxlintrc.json."
              }
            ]
          }
        ]
      }
    },
    {
      // Keep the client-importable convex/lib modules pure: runtime imports
      // only from convex/values or each other.
      "files": [
        "convex/lib/explore.ts",
        "convex/lib/geo.ts",
        "convex/lib/topics.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*", "./*", "!./explore", "!./geo", "!./topics"],
                "allowTypeImports": true,
                "message": "This convex/lib module is imported by client code; keep its runtime imports pure (see .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      // Tests are not bundled, and router/link mocks render bare <a> elements.
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "jsx-a11y/anchor-is-valid": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      // ARIA combobox pattern: keyboard selection is handled on the input via
      // aria-activedescendant; options only take pointer clicks.
      "files": ["src/components/ui/city-combobox.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "warn"
      }
    },
    {
      // Horizontally scrollable region must be focusable for keyboard
      // scrolling (WCAG 2.1.1).
      "files": ["src/components/ui/contribution-graph.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-tabindex": "warn"
      }
    }
  ]
}
