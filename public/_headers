# Headers for static files served by Cloudflare Workers static assets. SSR
# and server-route responses get theirs from src/lib/security-headers.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite build output: file names carry a content hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts keep their names across updates, so cache for 30 days, not forever.
/fonts/*
  Cache-Control: public, max-age=2592000

/og-image.png
  Cache-Control: public, max-age=86400

/favicon*
  Cache-Control: public, max-age=86400

/icon-*
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
