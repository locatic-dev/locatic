# Browser / client bundle
# Clerk publishable key (required by ClerkProvider in the browser)
VITE_CLERK_PUBLISHABLE_KEY=

# Convex React client URL (required in the browser)
VITE_CONVEX_URL=

# TanStack Start server
# Clerk secret key (required for server-side auth() and getToken())
CLERK_SECRET_KEY=

# Playwright E2E
# Dedicated Clerk development/test user email used by @clerk/testing.
E2E_CLERK_USER_EMAIL=

# Convex CLI / deployment selection
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment / runtime
# Clerk issuer domain used by convex/auth.config.ts
CLERK_JWT_ISSUER_DOMAIN=
# Required in Convex if server-side actions call Clerk's Backend API
# Example: convex/github_actions.ts
# CLERK_SECRET_KEY=
# Required in Convex if using the /clerk/webhooks handler
# Set with: pnpm exec convex env set CLERK_WEBHOOK_SIGNING_SECRET
# CLERK_WEBHOOK_SIGNING_SECRET=
