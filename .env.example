# Browser / client bundle
# Clerk publishable key (required by ClerkProvider in the browser)
VITE_CLERK_PUBLISHABLE_KEY=

# Convex React client URL (required in the browser)
VITE_CONVEX_URL=

# Cloudflare Web Analytics beacon token (optional, public). The beacon loads
# only in production builds when this is set.
VITE_CF_BEACON_TOKEN=

# TanStack Start server
# Clerk secret key (required for server-side auth() and getToken())
CLERK_SECRET_KEY=

# Playwright E2E
# Dedicated Clerk development/test user email used by @clerk/testing.
E2E_CLERK_USER_EMAIL=
# Full release personas; not required for pnpm e2e:components.
E2E_PUBLIC_PROFILE_USERNAME=
E2E_CLERK_EMPTY_CITY_USER_EMAIL=
E2E_CLERK_ONBOARDING_USER_EMAIL=
# Strict member QA only: disposable target and explicit onboarding-reset opt-in.
# See docs/DEVELOPMENT_QA.md before enabling. Never use production credentials.
E2E_FIXTURE_CONVEX_URL=
E2E_RESET_FIXTURES=
# CI uses an environment secret E2E_CONVEX_DEPLOY_KEY as CONVEX_DEPLOY_KEY.
# Local operators may instead use their existing Convex CLI login.
# E2E_MODE=smoke is explicitly partial; omit for strict release validation.

# Convex CLI / deployment selection
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex deployment / runtime
# Clerk issuer domain used by convex/auth.config.ts
CLERK_JWT_ISSUER_DOMAIN=
# Required in Convex if server-side actions call Clerk's Backend API
# Example: convex/github_actions.ts
# CLERK_SECRET_KEY=
# Required in Convex if using the /clerk/webhooks handler
# Set with: pnpm exec convex env set CLERK_WEBHOOK_SIGNING_SECRET
# CLERK_WEBHOOK_SIGNING_SECRET=

# Disposable fixture runtime only (set in that Convex deployment, not Vite):
# E2E_FIXTURES_ENABLED=true
# E2E_FIXTURE_CONVEX_URL=https://YOUR-DISPOSABLE-DEPLOYMENT.convex.cloud
# E2E_FIXTURE_CLERK_IDS=user_POPULATED,user_EMPTY,user_ONBOARDING
# All EMAIL_*_ENABLED flags must be false; CLERK_SECRET_KEY must be sk_test_*.

# Email (Resend). Set each in Convex: pnpm exec convex env set NAME value
# Sending stays off unless EMAIL_SENDING_ENABLED=true.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# RESEND_SEGMENT_ID=
# RESEND_TOPIC_ID=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# Application link origin for email links. Required to send campaigns.
# SITE_URL=
# Unsubscribe-link signing key (required to send) and the previous key, kept
# for 30 days when rotating.
# EMAIL_UNSUBSCRIBE_SECRET=
# EMAIL_UNSUBSCRIBE_SECRET_PREVIOUS=
# Optional campaign-copy destination and footer postal address
# EMAIL_COPY_ADDRESS=
# EMAIL_POSTAL_ADDRESS=
# EMAIL_SENDING_ENABLED=
# EMAIL_CONTACT_SYNC_ENABLED=
# EMAIL_TEST_SENDING_ENABLED=
# EMAIL_TEST_RECIPIENTS=
# Comma-separated Clerk user IDs allowed to use /admin/emails
# EMAIL_ADMIN_CLERK_IDS=
